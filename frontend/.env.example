# Скопируйте в frontend/.env и подставьте свой URL.
# В проде на Vercel укажите URL Render-сервиса бэкенда (например https://kinoclone-api.onrender.com).
VITE_API_BASE_URL=

# Локально можно переопределить адрес Django dev-сервера, на который смотрит /api proxy.
# По умолчанию http://localhost:8000.
VITE_DEV_API_PROXY=http://localhost:8000
