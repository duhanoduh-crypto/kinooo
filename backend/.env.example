# Скопируйте в backend/.env и заполните своими значениями.

# Django
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных. Можно оставить пустым (тогда поднимется SQLite в backend/db.sqlite3),
# либо указать строку подключения PostgreSQL — например, для локального Postgres:
# DATABASE_URL=postgres://kinoclone:kinoclone@localhost:5432/kinoclone
DATABASE_URL=

# CORS / CSRF (через запятую). На Vercel укажите ваш прод-домен.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Регулярка для CORS (по умолчанию пускает все *.vercel.app).
DJANGO_CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$
